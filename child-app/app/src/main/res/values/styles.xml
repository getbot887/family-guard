<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Base theme -->
    <style name="Theme.FamilyGuard" parent="Theme.Material3.Light.NoActionBar">
        <item name="colorPrimary">@color/primary</item>
        <item name="colorOnPrimary">@color/md_theme_light_onPrimary</item>
        <item name="colorPrimaryContainer">@color/md_theme_light_primaryContainer</item>
        <item name="colorOnPrimaryContainer">@color/md_theme_light_onPrimaryContainer</item>
        <item name="colorSecondary">@color/md_theme_light_secondary</item>
        <item name="colorSurface">@color/md_theme_light_surface</item>
        <item name="colorOnSurface">@color/md_theme_light_onSurface</item>
        <item name="colorSurfaceVariant">@color/md_theme_light_surfaceVariant</item>
        <item name="android:statusBarColor">@color/primary_dark</item>
        <item name="android:windowBackground">@color/bg</item>
        <item name="shapeAppearanceSmallComponent">@style/ShapeSmall</item>
        <item name="shapeAppearanceMediumComponent">@style/ShapeMedium</item>
    </style>

    <style name="ShapeSmall" parent="ShapeAppearance.Material3.SmallComponent">
        <item name="cornerSize">@dimen/button_radius</item>
    </style>

    <style name="ShapeMedium" parent="ShapeAppearance.Material3.MediumComponent">
        <item name="cornerSize">@dimen/card_radius</item>
    </style>

    <!-- Buttons -->
    <style name="Widget.FamilyGuard.Button.Primary" parent="Widget.Material3.Button">
        <item name="backgroundTint">@color/primary</item>
        <item name="cornerRadius">@dimen/button_radius</item>
        <item name="android:textColor">@color/md_theme_light_onPrimary</item>
        <item name="android:textSize">@dimen/text_body</item>
        <item name="android:minHeight">44dp</item>
    </style>

    <style name="Widget.FamilyGuard.Button.Outline" parent="Widget.Material3.Button.OutlinedButton">
        <item name="strokeColor">@color/primary</item>
        <item name="cornerRadius">@dimen/button_radius</item>
        <item name="android:textColor">@color/primary</item>
        <item name="android:textSize">@dimen/text_body</item>
        <item name="android:minHeight">44dp</item>
    </style>

    <style name="Widget.FamilyGuard.Button.Text" parent="Widget.Material3.Button.TextButton">
        <item name="android:textColor">@color/primary</item>
        <item name="android:textSize">@dimen/text_caption</item>
        <item name="android:minHeight">36dp</item>
    </style>

    <style name="Widget.FamilyGuard.Button.Small" parent="Widget.Material3.Button.TonalButton">
        <item name="backgroundTint">@color/primary_light</item>
        <item name="cornerRadius">6dp</item>
        <item name="android:textColor">@color/primary</item>
        <item name="android:textSize">@dimen/text_caption</item>
        <item name="android:minHeight">32dp</item>
        <item name="insetTop">0dp</item>
        <item name="insetBottom">0dp</item>
    </style>

    <!-- Card -->
    <style name="Widget.FamilyGuard.Card" parent="Widget.Material3.CardView.Elevated">
        <item name="cardCornerRadius">@dimen/card_radius</item>
        <item name="cardElevation">@dimen/card_elevation</item>
        <item name="cardBackgroundColor">@color/card</item>
        <item name="strokeWidth">0dp</item>
        <item name="contentPadding">@dimen/spacing_lg</item>
    </style>

    <!-- Input field -->
    <style name="Widget.FamilyGuard.TextInput" parent="Widget.Material3.TextInputLayout.OutlinedBox">
        <item name="boxCornerRadiusTopStart">@dimen/button_radius</item>
        <item name="boxCornerRadiusTopEnd">@dimen/button_radius</item>
        <item name="boxCornerRadiusBottomStart">@dimen/button_radius</item>
        <item name="boxCornerRadiusBottomEnd">@dimen/button_radius</item>
        <item name="boxStrokeColor">@color/border</item>
        <item name="hintTextColor">@color/primary</item>
    </style>

    <!-- Text styles -->
    <style name="CardTitle" parent="TextAppearance.Material3.TitleMedium">
        <item name="android:textSize">@dimen/text_subtitle</item>
        <item name="android:textColor">@color/text_primary</item>
        <item name="android:fontFamily">sans-serif-medium</item>
    </style>

    <style name="CardBody" parent="TextAppearance.Material3.BodyMedium">
        <item name="android:textSize">@dimen/text_body</item>
        <item name="android:textColor">@color/text_primary</item>
    </style>

    <style name="SectionHeader" parent="TextAppearance.Material3.TitleMedium">
        <item name="android:textSize">@dimen/text_subtitle</item>
        <item name="android:textColor">@color/text_primary</item>
        <item name="android:fontFamily">sans-serif-medium</item>
    </style>

    <style name="BodySecondary" parent="TextAppearance.Material3.BodyMedium">
        <item name="android:textSize">@dimen/text_body</item>
        <item name="android:textColor">@color/text_secondary</item>
    </style>

    <style name="StatValue" parent="TextAppearance.Material3.HeadlineMedium">
        <item name="android:textSize">@dimen/stat_value_medium</item>
        <item name="android:textColor">@color/primary</item>
        <item name="android:fontFamily">sans-serif-medium</item>
    </style>

    <style name="StatLabel" parent="TextAppearance.Material3.LabelSmall">
        <item name="android:textSize">@dimen/text_caption</item>
        <item name="android:textColor">@color/text_secondary</item>
    </style>

    <style name="StatusGood" parent="TextAppearance.Material3.BodySmall">
        <item name="android:textColor">@color/success</item>
        <item name="android:textSize">@dimen/text_caption</item>
    </style>

    <style name="StatusBad" parent="TextAppearance.Material3.BodySmall">
        <item name="android:textColor">@color/error</item>
        <item name="android:textSize">@dimen/text_caption</item>
    </style>
</resources>
