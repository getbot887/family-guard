<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="Theme.FamilyGuard" parent="Theme.AppCompat.NoActionBar">
        <item name="colorPrimary">@color/primary</item>
        <item name="colorPrimaryDark">@color/primary_dark</item>
        <item name="colorAccent">@color/accent</item>
        <item name="android:statusBarColor">@color/primary_dark</item>
        <item name="android:windowBackground">@color/bg</item>
    </style>

    <style name="CardTitle" parent="TextAppearance.AppCompat.Title">
        <item name="android:textSize">20sp</item>
        <item name="android:textColor">@color/text_primary</item>
        <item name="android:fontFamily">sans-serif-medium</item>
    </style>

    <style name="CardBody" parent="TextAppearance.AppCompat.Body1">
        <item name="android:textSize">14sp</item>
        <item name="android:textColor">@color/text_primary</item>
    </style>

    <style name="StatusGood" parent="TextAppearance.AppCompat.Body2">
        <item name="android:textColor">@color/success</item>
        <item name="android:textSize">13sp</item>
    </style>

    <style name="StatusBad" parent="TextAppearance.AppCompat.Body2">
        <item name="android:textColor">@color/error</item>
        <item name="android:textSize">13sp</item>
    </style>
</resources>
